#if SPY_SIZEOF_FLOAT == 4
    #ifndef SPY_FLOAT32
    #define SPY_FLOAT32
        typedef float spy_float32;
    #endif
#elif SPY_SIZEOF_FLOAT == 8
    #ifndef SPY_FLOAT64
    #define SPY_FLOAT64
        typedef float spy_float64;
    #endif
