#mesondefine HAVE___BUILTIN_BSWAP16
#mesondefine HAVE___BUILTIN_BSWAP32
#mesondefine HAVE___BUILTIN_BSWAP64

#mesondefine IS_LITTLE_ENDIAN
#mesondefine IS_BIG_ENDIAN

#include <stdint.h>
typedef int8_t  spy_int8;
typedef int16_t spy_int16;
typedef int32_t spy_int32;
typedef int64_t spy_int64;

typedef uint8_t  spy_uint8;
typedef uint16_t spy_uint16;
typedef uint32_t spy_uint32;
typedef uint64_t spy_uint64;

