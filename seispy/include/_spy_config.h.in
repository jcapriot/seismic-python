    #define SPY_FLOAT32
        typedef double spy_float32;
    #endif
#elif SPY_SIZEOF_DOUBLE == 8
    #ifndef SPY_FLOAT64
    #define SPY_FLOAT64
        typedef double spy_float64;
    #endif
